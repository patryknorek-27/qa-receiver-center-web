{
  "Server": {
    "ListenAddress": "127.0.0.1",
    "Port": 8787,
    "UseHttps": false,
    "CertificateThumbprint": ""
  },
  "Registry": {
    "DatabasePath": "data/receivers.db",
    "CloneFilesPath": "clone-files",
    "BackupPath": "backups",
    "BusyTimeoutSeconds": 15,
    "BackupIntervalHours": 24,
    "BackupRetentionCount": 14,
    "BackupOnStartup": true
  },
  "Features": {
    "IpManagementEnabled": false,
    "GuestPortalEnabled": false
  },
  "IpPing": {
    "Enabled": true,
    "MaxParallelism": 32
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
