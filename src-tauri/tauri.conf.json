{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QA Receiver Center",
  "version": "0.3.0",
  "identifier": "com.trimble.qa.receiver-center",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "title": "QA Receiver Center",
        "width": 1680,
        "height": 1000,
        "minWidth": 1040,
        "minHeight": 720,
        "maximized": true,
        "backgroundColor": "#000000",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
